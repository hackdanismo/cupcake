# Variables
let name = "Cake";
let count = 0;

# A function with parameters
function greet(person) {
    return "Hello " + person;
}

# Arrays
let numbers = [10, 20, 30];
append(numbers, 40);

# Maps
let language = {
    name: "Cake",
    version: 1
};

# Loop
while (count < 3) {
    count = count + 1;
}

# Conditional
if (count == 3) {
    print(greet(name));
} else {
    print("Something went wrong");
}